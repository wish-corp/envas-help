---
import { docPath, type DocEntry } from '../lib/docs';

interface Props {
  entries: DocEntry[];
  currentId: string;
}

const { entries, currentId } = Astro.props;
---
<aside class="side" aria-label="ヘルプのページ一覧">
  <div class="heading">
    <span class="heading-en">Guide</span>
    <span class="heading-ja">ヘルプ一覧</span>
  </div>
  <ul>
    {entries.map((entry) => {
      const isCurrent = entry.id === currentId;
      return (
        <li>
          <a
            class:list={['side-link', { current: isCurrent }]}
            href={docPath(entry.id)}
            aria-current={isCurrent ? 'page' : undefined}
          >
            {isCurrent && (
              <svg width="6" height="6" viewBox="0 0 8 8" aria-hidden="true"><path d="M4 0 8 4 4 8 0 4Z" fill="#E7A03C"></path></svg>
            )}
            <span class="side-title">{entry.data.title}</span>
          </a>
        </li>
      );
    })}
  </ul>
</aside>

<style>
  .side {
    position: sticky;
    top: 32px;
    max-height: calc(100vh - 64px);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .heading {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .heading-en {
    font-family: var(--font-en);
    font-style: italic;
    font-size: 17px;
    color: var(--color-link);
  }
  .heading-ja {
    font-family: var(--font-mincho);
    font-weight: 500;
    font-size: 15px;
    letter-spacing: 0.1em;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }
  li {
    border-bottom: 1px solid var(--color-border);
  }
  .side-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 0;
    color: var(--color-text);
    text-decoration: none;
  }
  .side-link:hover .side-title {
    color: var(--color-link);
  }
  .side-title {
    font-size: 13px;
    line-height: 1.75;
  }
  .current .side-title {
    color: var(--color-link);
    font-weight: 500;
  }
  @media (max-width: 1100px) {
    .side {
      display: none;
    }
  }
</style>
