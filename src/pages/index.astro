---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { docPath, getNavDocs, INDEX_ID } from '../lib/docs';
import { slugify, unique } from '../markdown/heading-ids';

const entries = await getNavDocs();
const intro = entries.find((entry) => entry.id === INDEX_ID);
if (!intro) {
  throw new Error(`src/nav.ts に ${INDEX_ID} が無い`);
}
const guides = entries.filter((entry) => entry.id !== INDEX_ID);
const { Content } = await render(intro);
const titleId = unique(slugify(intro.data.title), new Set());
---
<BaseLayout ogImagePath="/og/index.png" ogType="website">
  <main>
    <p class="eyebrow">HELP</p>
    <article class="intro" data-pagefind-body>
      <header class="intro-header">
        <h1 id={titleId} class="intro-title">{intro.data.title}</h1>
        <div class="ornament" aria-hidden="true">
          <span class="line"></span>
          <svg width="9" height="9" viewBox="0 0 8 8"><path d="M4 0 8 4 4 8 0 4Z" fill="#E7A03C"></path></svg>
          <span class="line"></span>
        </div>
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>

    <section class="guides" aria-label="ヘルプのページ一覧">
      <h2 class="guides-title">ヘルプ一覧</h2>
      <ul class="cards">
        {guides.map((entry) => (
          <li>
            <a class="card" href={docPath(entry.id)}>
              <span class="card-title">{entry.data.title}</span>
              <svg width="28" height="12" viewBox="0 0 28 12" fill="none" stroke="#E7A03C" stroke-width="1" aria-hidden="true"><path d="M0 6h27M21 1l6 5-6 5"></path></svg>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    padding: 104px 32px 0;
  }
  .eyebrow {
    margin: 0;
    text-align: center;
    font-family: var(--font-en);
    font-size: 15px;
    letter-spacing: 0.42em;
    color: var(--color-link);
  }
  .intro {
    max-width: 760px;
    margin: 22px auto 0;
  }
  .intro-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }
  .intro-title {
    margin: 0;
    font-family: var(--font-mincho);
    font-weight: 500;
    font-size: 44px;
    letter-spacing: 0.16em;
  }
  .ornament {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .line {
    width: 64px;
    height: 1px;
    background: var(--color-brand);
  }
  .prose {
    margin-top: 56px;
  }
  .guides {
    max-width: 1040px;
    margin: 104px auto 0;
  }
  .guides-title {
    margin: 0 0 32px;
    text-align: center;
    font-family: var(--font-mincho);
    font-weight: 500;
    font-size: 25px;
    letter-spacing: 0.12em;
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
  }
  .card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 100%;
    box-sizing: border-box;
    padding: 28px 32px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    outline: 1px solid var(--color-border-inner);
    outline-offset: -7px;
    color: var(--color-text);
    text-decoration: none;
  }
  .card-title {
    font-family: var(--font-mincho);
    font-weight: 500;
    font-size: 17px;
    line-height: 1.7;
    letter-spacing: 0.04em;
  }
  .card svg {
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }
  .card:hover .card-title {
    color: var(--color-link);
  }
  .card:hover svg {
    transform: translateX(4px);
  }
  @media (max-width: 760px) {
    main {
      padding: 72px 16px 0;
    }
    .intro-title {
      font-size: 34px;
    }
  }
</style>
